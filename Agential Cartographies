        // ---------- ISRAELI AREAS (highlighted red overlay) ----------
        // Based on typical separation barrier / Israeli municipal areas near Bethlehem:
        // Gilo area, Har Homa, Efrat region (symbolic representation)
        const israeliZones = [
            // Area near Gilo / Har Homa (north-west of Bethlehem)
            [[31.7260, 35.1860], [31.7320, 35.1900], [31.7300, 35.1970], [31.7230, 35.1960], [31.7210, 35.1900], [31.7260, 35.1860]],
            // Southern Israeli settlement bloc (Efrat surroundings)
            [[31.6600, 35.1500], [31.6700, 35.1550], [31.6720, 35.1650], [31.6640, 35.1680], [31.6580, 35.1600], [31.6600, 35.1500]]
        ];
        
        // ---------- SEPARATION BARRIER (thick red line) ----------
        // Approximated route of the West Bank barrier near Bethlehem, Aida camp
        const barrierPoints = [
            [31.7245, 35.1920],  // north of Aida
            [31.7228, 35.1945],
            [31.7211, 35.1973],  // adjacent to wall 02
            [31.7205, 35.2003],  // entrance / wall zone
            [31.7188, 35.2010],
            [31.7160, 35.2005],
            [31.7145, 35.1990],
            [31.7120, 35.1975],
            [31.7100, 35.1960],
            [31.7075, 35.1950],
            [31.7050, 35.1952]
        ];
        
        // ---------- MAP INITIALIZATION ----------
        // Compute total bounds encompassing all zones + some margin (ensure no zooming out beyond this)
        const allBoundsCoords = [
            [31.735, 35.260],  // NE limit zone C
            [31.715, 35.270],  // high east
            [31.700, 35.205],  // Old city south
            [31.702, 35.185],  // west of Bethlehem
            [31.725, 35.188],  // NW barrier
            [31.736, 35.260]
        ];
        const maxBoundary = L.latLngBounds(allBoundsCoords);
        
        const map = L.map('map', {
            center: [31.719, 35.207],
            zoom: 14,
            zoomControl: true,
            scrollWheelZoom: true,
            maxBounds: maxBoundary,
            maxBoundsViscosity: 1.0,   // cannot pan outside
            minZoom: 13,
            maxZoom: 18
        });
        
        // Enforce no zoom out beyond minZoom (13) so the user never sees irrelevant areas
        map.setMinZoom(13);
        map.setMaxZoom(18);
        
        // Black-and-white tile layer (buildings appear white due to strong contrast)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '',
            maxZoom: 19,
            minZoom: 12
        }).addTo(map);
        
        // Additional CSS-like forced style in tile layer filter already in global style
        
        // ---------- DRAW ZONE BOUNDARIES (white dashed lines) ----------
        function addZoneBoundary(coordinates, zoneName) {
            const polyline = L.polyline(coordinates, {
                color: '#ffffff',
                weight: 2,
                opacity: 0.65,
                dashArray: '5, 8',
                fill: false,
                interactive: false
            }).addTo(map);
            polyline.bindTooltip(zoneName, { sticky: true, className: 'zone-tooltip' });
            return polyline;
        }
        
        addZoneBoundary(zoneA.coords, zoneA.name);
        addZoneBoundary(zoneB.coords, zoneB.name);
        addZoneBoundary(zoneC.coords, zoneC.name);
        
        // Optional: fill zones with subtle transparent indication? not needed, but boundaries clear.
        
        // ---------- ISRAELI AREAS (filled red polygons with low opacity but visible) ----------
        israeliZones.forEach(zoneCoords => {
            L.polygon(zoneCoords, {
                color: '#ff4d4d',
                weight: 2,
                fillColor: '#dd3333',
                fillOpacity: 0.35,
                opacity: 0.8,
                interactive: false
            }).addTo(map);
        });
        
        // ---------- SEPARATION BARRIER (thick red line) ----------
        L.polyline(barrierPoints, {
            color: '#ff0000',
            weight: 5,
            opacity: 0.95,
            lineCap: 'round',
            lineJoin: 'round',
            interactive: false,
            className: 'separation-barrier'
        }).addTo(map);
        
        // Additional small segment near checkpoint / wall extension
        const extensionPoints = [
            [31.7205, 35.2004],
            [31.7201, 35.2012],
            [31.7190, 35.2015]
        ];
        L.polyline(extensionPoints, {
            color: '#ff0000',
            weight: 5,
            opacity: 0.9
        }).addTo(map);
        
        // ---------- FIELD SITE MARKERS (white circles, variable size) ----------
        // Group locations by exact coordinates
        const locationMap = {};
        data.forEach(entry => {
            const key = `${entry.lat.toFixed(6)},${entry.lng.toFixed(6)}`;
            if (!locationMap[key]) {
                locationMap[key] = {
                    lat: entry.lat,
                    lng: entry.lng,
                    places: [],
                    count: 0
                };
            }
            if (entry.place && entry.place.trim() !== "" && !locationMap[key].places.includes(entry.place)) {
                locationMap[key].places.push(entry.place);
            }
            locationMap[key].count++;
        });
        
        // Add circle markers (white fill, subtle outline)
        Object.values(locationMap).forEach(loc => {
            // radius between 5 and 14 based on number of visits / density
            let radius = Math.min(14, 4 + loc.count * 1.2);
            if (loc.count > 5) radius = 12;
            const primaryName = loc.places.length > 0 ? loc.places[0] : 'Unnamed site';
            // Create popup content with all unique place descriptors
            let uniquePlacesList = loc.places.slice(0, 3).join(', ');
            if (loc.places.length > 3) uniquePlacesList += ` +${loc.places.length-3} more`;
            
            const popupHtml = `
                <div class="popup-content">
                    <div class="popup-title">📍 ${primaryName}</div>
                    <div class="popup-info">
                        <p><strong>📌 ${loc.count}</strong> recording${loc.count > 1 ? 's' : ''}</p>
                        ${loc.places.length > 0 ? `<p>🏷️ ${uniquePlacesList}</p>` : ''}
                        <p>🗺️ ${loc.lat.toFixed(5)}°N, ${loc.lng.toFixed(5)}°E</p>
                        <p style="font-size:11px; color:#aaa;">Fieldwork marker (Agential Trails)</p>
                    </div>
                </div>
            `;
            
            L.circleMarker([loc.lat, loc.lng], {
                radius: radius,
                fillColor: '#ffffff',
                color: 'rgba(255, 255, 255, 0.6)',
                weight: 1.8,
                opacity: 0.9,
                fillOpacity: 0.85
            }).bindPopup(popupHtml).addTo(map);
        });
        
        // Also add explicit additional labels for key landmarks? Not needed but ensures all points shown.
        
        // Update site count (unique clustered locations)
        document.getElementById('siteCount').textContent = Object.keys(locationMap).length;
        
        // Additional contextual building outlines are represented in OSM tiles forced to white:
        // Our CSS .leaflet-tile filter: grayscale + brightness(0.2) makes roads dark, buildings white/grey.
        // To enhance building visibility: we add extra contrast by ensuring background pure black.
