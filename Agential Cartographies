        // -------------------------------
        // 1. DEFINE 3 ZONES (boundaries with no zoom out restriction beyond the maxBounds)
        // Zone A: Bethlehem City Center & Old City
        // Zone B: Aida Camp & surroundings
        // Zone C: Northern hills / Khirbet areas (Beit Jala outskirts)
        // Each zone has a polygon boundary displayed visually (white dashed lines)
        // -------------------------------
        
        const zoneA = {
            name: "Bethlehem Old City & Center",
            coords: [
                [31.7095, 35.2000],
                [31.7120, 35.2055],
                [31.7080, 35.2090],
                [31.7035, 35.2065],
                [31.7028, 35.2020],
                [31.7060, 35.1995],
                [31.7095, 35.2000]
            ]
        };
        
        const zoneB = {
            name: "Aida Camp & Vicinity",
            coords: [
                [31.7225, 35.1945],
                [31.7228, 35.2000],
                [31.7200, 35.2020],
                [31.7168, 35.2018],
                [31.7165, 35.1968],
                [31.7185, 35.1950],
                [31.7225, 35.1945]
            ]
        };
        
        const zoneC = {
            name: "Northern Khirbet Areas (Khirbet al-Hirzan etc.)",
            coords: [
                [31.7360, 35.2650],
                [31.7375, 35.2715],
                [31.7315, 35.2730],
