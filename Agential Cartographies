<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Agential Trails - Bethlehem Fieldwork Map</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html, body {
            width: 100%;
            height: 100%;
            background: #000;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        
        body {
            display: flex;
            flex-direction: column;
        }
        
        header {
            background: #000;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 20px 40px;
            z-index: 100;
        }
        
        header h1 {
            font-size: 24px;
            font-weight: 400;
            margin-bottom: 4px;
        }
        
        header p {
            font-size: 14px;
            color: #999;
        }
        
        #mapContainer {
            flex: 1;
            position: relative;
        }
        
        #map {
            width: 100%;
            height: 100%;
        }
        
        /* Pure black background, monochrome tiles */
        .leaflet-container {
            background: #000000;
            font-family: inherit;
        }
        
        /* Force OSM tiles to render as black-and-white: buildings white, terrain dark */
        .leaflet-tile {
            filter: grayscale(100%) brightness(0.2) contrast(1.5) invert(0) !important;
            -webkit-filter: grayscale(100%) brightness(0.2) contrast(1.5) invert(0) !important;
        }
        
        /* Additional overlay to ensure dark base — but tiles become mostly black with white/gray outlines */
        .leaflet-tile-pane {
            opacity: 0.92;
        }
        
        .leaflet-control-attribution {
            display: none !important;
        }
        
        .leaflet-control {
            background: rgba(0,0,0,0.85) !important;
            border: 1px solid rgba(255,255,255,0.25) !important;
        }
        
        .leaflet-control a {
            color: #ddd !important;
        }
        
        .leaflet-popup-content-wrapper {
            background: #111;
            color: #fff;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 2px;
        }
        
        .leaflet-popup-tip {
            background: #111;
        }
        
        .popup-content {
            padding: 8px 0;
            font-size: 13px;
        }
        
        .popup-title {
            font-weight: 500;
            margin-bottom: 8px;
            border-bottom: 1px solid rgba(255,255,255,0.2);
            padding-bottom: 8px;
        }
        
        .popup-info {
            color: #ccc;
            margin-top: 8px;
            line-height: 1.5;
        }
        
        .popup-info p {
            margin: 4px 0;
            font-size: 12px;
        }
        
        .info-box {
            position: absolute;
            bottom: 20px;
            left: 20px;
            background: rgba(0,0,0,0.9);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 16px;
            border-radius: 2px;
            max-width: 280px;
            z-index: 1000;
            font-size: 13px;
            line-height: 1.6;
            backdrop-filter: blur(4px);
        }
        
        .info-box h3 {
            font-size: 14px;
            margin-bottom: 8px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            padding-bottom: 8px;
        }
        
        .info-box p {
            color: #bbb;
            margin: 6px 0;
        }
        
        .stat {
            color: #fff;
            font-weight: 500;
        }
        
        /* Custom legend */
        .legend {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: rgba(0,0,0,0.85);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 12px 16px;
            z-index: 1000;
            font-size: 12px;
            border-radius: 2px;
            pointer-events: none;
        }
        .legend span {
            display: inline-block;
            width: 20px;
            height: 3px;
            vertical-align: middle;
            margin-right: 6px;
        }
        .legend .barrier-line {
            height: 4px;
            background: #ff3a3a;
            width: 24px;
        }
        .legend .israeli-area {
            background: rgba(220, 40, 40, 0.5);
            width: 20px;
            height: 12px;
            border: 1px solid #ff5a5a;
        }
        .legend-item {
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
    </style>
</head>
